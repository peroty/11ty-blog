---
layout: layouts/base.njk
title: Quotes
permalink: /quotes/
---

<header class="page-header">
  <h1>Quotes</h1>
  <p class="tagline">Words worth remembering</p>
</header>

{% set quoteList = collections.quotes %}
{% set linkList = collections.linkPosts %}
{% if quoteList.length %}
  {% for quote in quoteList %}
    <article class="post-item post-type-quote">
      <header>
        <h2 class="post-title"><span class="post-type-icon title-icon">❝</span> <a href="{{ quote.url }}">Quote</a></h2>
        <div class="post-meta"><time datetime="{{ quote.date | w3DateFilter }}">{{ quote.date | readableDate }}</time></div>
      </header>
      <blockquote class="quote-copy">{{ quote.templateContent | safe }}</blockquote>
      {% if quote.data.quoteAuthor %}<p class="quote-attribution">— {{ quote.data.quoteAuthor }}</p>{% endif %}
      {% if quote.data.quoteSourceUrl %}<p><a href="{{ quote.data.quoteSourceUrl }}" target="_blank" rel="noopener noreferrer">Source ↗</a></p>{% endif %}
      <p class="permalink-line"><a href="{{ quote.url }}" class="permalink-link">Permalink</a></p>
    </article>
  {% endfor %}
{% endif %}
{% if linkList.length %}
  {% for link in linkList %}
    <article class="post-item post-type-link">
      <header>
        <h2 class="post-title">
          <span class="post-type-icon title-icon">💬</span>
          <a href="{{ link.data.linkUrl }}" target="_blank" rel="noopener noreferrer">
            {{ link.data.title }} <span class="external-indicator" aria-hidden="true">↗</span>
          </a>
        </h2>
        
        <div class="post-meta">
          <time datetime="{{ link.date | w3DateFilter }}">
            {{ link.date | readableDate }}
          </time>
          
          {% if link.data.tags %}
            <span class="post-tags">
              {% for tag in link.data.tags %}
                {% if tag != "link" %}
                  <a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
                  {% if not loop.last %}, {% endif %}
                {% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </div>
      </header>
      
      <div class="post-excerpt">
        {{ link.templateContent | safe }}
        <p class="permalink-line">
          <a href="{{ link.url }}" class="permalink-link">
            <span class="permalink-glyph" aria-hidden="true">𓅰</span>
            <span class="permalink-label">Permalink</span>
          </a>
        </p>
      </div>
    </article>
  {% endfor %}
{% elif not quoteList.length %}
  <p>No quotes yet.</p>
{% endif %}
