---
layout: layouts/base.njk
title: Archives
permalink: /archives/
---

<header class="page-header">
  <h1>Post Archives</h1>
  <p class="tagline">Long-form entries and journal posts</p>
</header>

{% set postList = collections.posts %}
{% if postList.length %}
  {% for post in postList %}
    <article class="post-item post-type-post">
      <header>
        <h2 class="post-title">
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        </h2>
        
        <div class="post-meta">
          <time datetime="{{ post.date | w3DateFilter }}">
            {{ post.date | readableDate }}
          </time>
          
          {% if post.data.tags %}
            <span class="post-tags">
              {% for tag in post.data.tags %}
                {% if tag != "post" %}
                  <a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
                  {% if not loop.last %}, {% endif %}
                {% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </div>
      </header>
      
      <div class="post-content">
        {{ post.templateContent | safe }}
        <p class="permalink-line">
          <a href="{{ post.url }}" class="permalink-link">
            <span class="permalink-glyph" aria-hidden="true">𓅰</span>
            <span class="permalink-label">Permalink</span>
          </a>
        </p>
      </div>
    </article>
  {% endfor %}
{% else %}
  <p>No posts yet.</p>
{% endif %}
