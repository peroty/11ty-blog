---
layout: layouts/base.njk
---

<article class="bookmark bookmark-item">
  <header class="bookmark-header">
    <h1 class="bookmark-title">
      <span class="bookmark-icon title-icon">⌗</span>
      <a href="{{ bookmarkUrl }}" class="bookmark-link" target="_blank" rel="noopener noreferrer">
        {{ title }} <span class="external-indicator">↗</span>
      </a>
    </h1>
    
    <div class="bookmark-meta">
      <time datetime="{{ page.date | w3DateFilter }}">
        {{ page.date | readableDate }}
      </time>
      
      {% if tags %}
        <span class="bookmark-tags">
          {% for tag in tags %}
            {% if tag != "bookmark" %}
              <a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </header>
  
  <div class="bookmark-content">
    {% if description %}
      <p class="bookmark-description">{{ description }}</p>
    {% endif %}
    {{ content | safe }}
    <p class="permalink-line">
      <a href="{{ page.url }}" class="permalink-link">
        <span class="permalink-glyph" aria-hidden="true">𓅰</span>
        <span class="permalink-label">Permalink</span>
      </a>
    </p>
  </div>
  
  <footer class="bookmark-footer">
    <a href="{{ bookmarkUrl }}" class="bookmark-source" target="_blank" rel="noopener noreferrer">
      {{ bookmarkUrl | replace('https://', '') | replace('http://', '') | truncate(50, true) }}
    </a>
  </footer>
</article>
