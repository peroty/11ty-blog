---
layout: layouts/base.njk
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    
    <div class="post-meta">
      <time datetime="{{ page.date | w3DateFilter }}">
        {{ page.date | readableDate }}
      </time>
      
      {% if tags %}
        <span class="post-tags">
          {% for tag in tags %}
            {% if tag != "post" %}
              <a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
              {% if not loop.last %}, {% endif %}
            {% endif %}
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </header>
  
  <div class="post-content">
    {{ content | safe }}
    <p class="permalink-line">
      <a href="{{ page.url }}" class="permalink-link">
        <span class="permalink-glyph" aria-hidden="true">𓅰</span>
        <span class="permalink-label">Permalink</span>
      </a>
    </p>
  </div>
  
  <footer class="post-footer">
    <p>Thanks for reading. You can find more posts in the <a href="/archives/">archives</a>.</p>
  </footer>
</article>
