<header class="page-header preview-page-header">
  <h1>Font Preview</h1>
  <p class="tagline">The same font references and pairings inside the live Arctic Palace shell, now shown on soft moss-black and charcoal panels so the comparison stays focused on readability.</p>
</header>

<section class="font-preview-grid font-preview-grid-sources" aria-label="Reference site typography">
  {% for specimen in referenceSpecs %}
    <article class="font-preview-card">
      <header class="font-preview-card-header">
        <h2>{{ specimen.label }}</h2>
        <p>{{ specimen.description }}</p>
      </header>

      {{ renderSpecimen(specimen) }}
    </article>
  {% endfor %}
</section>

<section class="font-preview-grid" aria-label="Font combinations">
  {% for specimen in fontCombos %}
    <article class="font-preview-card">
      <header class="font-preview-card-header">
        <h2>{{ specimen.label }}</h2>
        <p>{{ specimen.description }}</p>
      </header>

      {{ renderSpecimen(specimen) }}
    </article>
  {% endfor %}
</section>
