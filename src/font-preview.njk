---
layout: layouts/base.njk
title: Font Preview
permalink: /font-preview/
---

{% set surfaces = [
  {
    "label": "Soft Moss Black",
    "value": "#101612",
    "className": "preview-surface-moss"
  },
  {
    "label": "Charcoal",
    "value": "#1b1d20",
    "className": "preview-surface-charcoal"
  }
] %}

{% macro renderSpecimen(specimen) %}
  <div class="font-preview-surface-grid">
    {% for surface in surfaces %}
      <section class="font-preview-specimen {{ specimen.titleClass }} {{ specimen.bodyClass }} {{ specimen.scaleClass }} {% if specimen.metaClass %}{{ specimen.metaClass }}{% endif %}">
        <div class="font-preview-specimen-meta">
          <span>{{ specimen.metaLabel }}</span>
          <span>{{ surface.label }} {{ surface.value }}</span>
        </div>

        <article class="post-item preview-specimen-post {% if specimen.reference %}preview-specimen-post-reference{% endif %} {{ surface.className }}">
          <header>
            <h3 class="post-title">
              <a href="#">{{ specimen.sampleTitle }}</a>
            </h3>

            <div class="post-meta">
              <time datetime="2026-04-06">April 6, 2026</time>
              <span class="post-tags">
                {% for tag in specimen.tags %}
                  <a href="#">{{ tag }}</a>{% if not loop.last %}, {% endif %}
                {% endfor %}
              </span>
            </div>
          </header>

          <div class="post-content">
            {% for paragraph in specimen.paragraphs %}
              <p>{{ paragraph | safe }}</p>
            {% endfor %}
            <blockquote>
              <p>{{ specimen.quote }}</p>
            </blockquote>
            <p class="permalink-line">
              <a href="#" class="permalink-link">
                <span class="permalink-glyph" aria-hidden="true">𓅰</span>
                <span class="permalink-label">Permalink</span>
              </a>
            </p>
          </div>
        </article>
      </section>
    {% endfor %}
  </div>
{% endmacro %}

