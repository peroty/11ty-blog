{
  "name": "11ty-blog",
  "version": "1.0.0",
  "description": "A beautiful blog with posts and notes, inspired by arcticpalace.org/journal",
  "scripts": {
    "start": "NODE_PATH=./node_modules ./node_modules/.bin/eleventy --config=../src/.eleventy.js --input=../src --output=../_site --serve --port=${SITE_PORT:-8080}",
    "build": "node ../scripts/clean-output.js && NODE_PATH=./node_modules ./node_modules/.bin/eleventy --config=../src/.eleventy.js --input=../src --output=${SITE_OUTPUT_DIR:-../_site}",
    "build:local": "NODE_PATH=./node_modules ./node_modules/.bin/eleventy --config=../src/.eleventy.js --input=../src --output=../_site",
    "watch": "NODE_PATH=./node_modules ./node_modules/.bin/eleventy --config=../src/.eleventy.js --input=../src --output=../_site --watch",
    "deploy": "bash ../scripts/deploy-pages.sh",
    "deploy:dreamhost": "bash ../scripts/deploy.sh",
    "admin": "NODE_PATH=./node_modules node ../src/admin/server.js",
    "test:admin": "NODE_PATH=./node_modules node --test ../src/admin/tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "luxon": "^3.5.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.0",
    "clean-css": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "multer": "^1.4.5-lts.1"
  }
}
